{
  "name": "bot-68",
  "version": "0.12.3",
  "private": true,
  "description": "BOT 68 - Omnichannel customer care desktop application",
  "main": "electron/main.cjs",
  "author": {
    "name": "BOT 68"
  },
  "homepage": "https://github.com/thanh324-hash/sportxauth",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env BOT68_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite",
    "dev:server": "node server/index.mjs",
    "test": "npm run test:server && npm run test:backup && npm run test:local-db",
    "test:server": "node --test server/*.test.mjs",
    "test:backup": "node --test electron/*.test.cjs",
    "test:local-db": "tsx --test src/db.test.ts",
    "build": "tsc -b && vite build",
    "build:win": "npm run build && electron-builder --win nsis",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/browser": "^8.0.1",
    "@capacitor/core": "^8.4.2",
    "dexie": "latest",
    "dexie-react-hooks": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "fake-indexeddb": "latest",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "vn.bot68.desktop",
    "productName": "BOT 68",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.svg",
      "executableName": "BOT 68",
      "legalTrademarks": "BOT 68",
      "target": [
        "nsis"
      ],
      "artifactName": "BOT-68-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BOT 68"
    }
  }
}
